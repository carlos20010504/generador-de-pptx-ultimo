# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data files
*.xlsx
!__tests__/baseline-snapshots/*.xlsx
!__tests__/fixtures/*.xlsx
*.pptx
*.json
!package.json
!package-lock.json
!tsconfig.json
*.pdf
*.txt
!requirements-dev.txt
!requirements.txt
*.csv
*.audit.json
!README_ADVANCED_PPTX.md
!Guia_Organizacion_Excel.md
!docs/superpowers/specs/*.md
!docs/superpowers/plans/*.md
/template_unpacked/
/ppt_review_*/
__pycache__/
*.pyc

# AI tooling state — these are auto-synced from global skill registries
# and shouldn't pollute the repo (every clone would re-sync them anyway).
.agents/
.trae/
.claude/scheduled_tasks.lock
.claude/skills/
