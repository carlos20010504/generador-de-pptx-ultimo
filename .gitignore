# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data files
*.xlsx
!__tests__/baseline-snapshots/*.xlsx
!__tests__/fixtures/*.xlsx
!tests/fixtures/*.xlsx
# Los .pptx generados (AUDIT_*, COMISIONES_*, etc.) son artefactos de prueba y
# NO deben ensuciar git status. Se restauró este patrón tras una regresión que
# lo había borrado. La plantilla del producto SÍ se versiona (excepción abajo).
*.pptx
!Plantilla_Presentacion_Socya (1) (1).pptx

*.json
!package.json
!package-lock.json
!tsconfig.json
*.pdf
*.txt
!requirements-dev.txt
!requirements.txt
*.csv
*.audit.json
!README_ADVANCED_PPTX.md
!Guia_Organizacion_Excel.md
!docs/superpowers/specs/*.md
!docs/superpowers/plans/*.md
/template_unpacked/
/ppt_review_*/
__pycache__/
*.pyc

# Cache de planes IA generado por socya_pipeline/ai_cache.py. Por defecto ahora
# vive fuera del árbol del proyecto (ver ai_cache.py), pero ignoramos .cache/
# por si un override SOCYA_CACHE_DIR lo apunta acá o por instalaciones viejas.
.cache/

# AI tooling state — these are auto-synced from global skill registries
# and shouldn't pollute the repo (every clone would re-sync them anyway).
.agents/
.trae/
.claude/scheduled_tasks.lock
.claude/skills/
