# Variables de entorno de la app. Copiá este archivo a `.env` para correr local
# (`.env` está en .gitignore y NO se versiona). En Render se cargan como
# secretos en el dashboard del servicio, no en este archivo.

# --- Claves de IA (al menos una requerida) ---
# Orden de fallback del pipeline: Cerebras > Groq > OpenRouter.
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Opcional; solo si usás Cerebras como primer proveedor.
CEREBRAS_API_KEY=

# --- Runtime ---
# Carpeta de caché de IA, fuera del árbol del proyecto. En Docker/Render apunta
# a un dir efímero escribible.
SOCYA_CACHE_DIR=/tmp/socya_cache

# PORT lo inyecta la plataforma (Render). `next start` lo respeta
# (default 3000). No hace falta definirlo acá para producción.
# PORT=3001
